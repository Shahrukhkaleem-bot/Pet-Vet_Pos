# VetPet Backend Environment Configuration
# Copy this file to .env and fill in your values

# App
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Database (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction Pooler (Port 6543) with ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. DIRECT_URL: Direct Session connection (Port 5432) used for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./storage/uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# WhatsApp (Phase 2 - Business API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
